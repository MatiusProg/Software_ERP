# Copia este archivo como .env y completa los valores reales.
# El .env NO se sube al repo (está en .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Agrega la IP de tu PC en la red local (ej. 192.168.0.11) para escanear el QR
# de la nota de venta desde el celular durante el desarrollo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/La_Paz

# --- PostgreSQL local (dev) ---
DB_NAME=erp_dev
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- CORS (orígenes del frontend/PWA) ---
# 5173 = panel React (Vite) · 5500 = PWA servida con Live Server
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# --- Nota de venta pública (QR) ---
# Vacío = se usa el host del request. En producción, el dominio donde se sirven
# las notas: NOTA_PUBLICA_BASE_URL=https://api.tu-negocio.com
NOTA_PUBLICA_BASE_URL=
