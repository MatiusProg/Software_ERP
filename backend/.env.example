# Copia este archivo como .env y completa los valores reales.
# El .env NO se sube al repo (está en .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
# Agrega la IP de tu PC en la red local (ej. 192.168.0.11) para escanear el QR
# de la nota de venta desde el celular durante el desarrollo.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/La_Paz

# --- PostgreSQL local (dev) ---
# Solo se usan si DATABASE_URL está vacía.
DB_NAME=erp_dev
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- PostgreSQL en producción (Supabase / Railway) ---
# Si se define, GANA sobre los DB_* de arriba. Ojo: ponerla aquí hace que tu
# desarrollo local apunte a la base de producción. Para una prueba puntual,
# mejor pasarla en la misma línea del comando:
#   DATABASE_URL="postgresql://..." python manage.py migrate
# Usar la cadena del *pooler* (puerto 6543); settings.py detecta ese puerto y
# desactiva sentencias preparadas y cursores de servidor, que PgBouncer en modo
# transacción no admite.
DATABASE_URL=
# Forzar ese ajuste aunque el puerto no sea 6543 (otro pooler en modo transacción).
DB_POOLER=False

# --- CORS (orígenes del frontend/PWA) ---
# 5173 = panel React (Vite) · 5500 = PWA servida con Live Server
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# --- CSRF (orígenes de confianza, CON esquema https://) ---
# En producción: las mismas URLs del panel y de la PWA. El dominio de Railway se
# agrega solo desde RAILWAY_PUBLIC_DOMAIN, no hace falta listarlo.
CSRF_TRUSTED_ORIGINS=

# --- Nota de venta pública (QR) ---
# Vacío = se usa el host del request. En producción, el dominio donde se sirven
# las notas: NOTA_PUBLICA_BASE_URL=https://api.tu-negocio.com
NOTA_PUBLICA_BASE_URL=
