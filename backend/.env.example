# ============================================================================
#  backend/.env.example — plantilla PÚBLICA (sin secretos)
# ============================================================================
#
#  Copiar como backend/.env y completar:   cp backend/.env.example backend/.env
#  Este archivo SÍ se sube al repo: nunca poner aquí un valor real.
#
#  Cómo se lee:
#    - Django lo carga al arrancar (config/settings.py → load_dotenv).
#    - Una variable que YA existe en el entorno gana sobre este archivo. Por eso
#      `docker compose` puede pisar DB_HOST, DATABASE_URL, etc. sin tocar nada aquí.
#    - Guardarlo SIEMPRE en UTF-8 SIN BOM. Con BOM (lo que agrega el Bloc de notas
#      de Windows), la primera variable se lee con un carácter invisible delante
#      y Django la ignora en silencio. Ya pasó una vez con DJANGO_SECRET_KEY.
#
#  Leyenda:  [usa el código]  la lee Django hoy.
#            [solo libreta]   NO la lee el código; está aquí para tenerla a mano
#                             (panel de Supabase, Railway, scripts, pgAdmin...).
#
# ============================================================================


# ----------------------------------------------------------------------------
# 1. DJANGO                                                    [usa el código]
# ----------------------------------------------------------------------------

# Clave para firmar sesiones y tokens JWT. Si cambia, todos los usuarios quedan
# deslogueados. La de producción debe ser OTRA, y vive solo en Railway.
# Generar una:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True en tu PC. En producción, False (activa HTTPS, HSTS y cookies seguras).
DJANGO_DEBUG=True

# Hosts que Django acepta. 192.168.X.X = tu PC en la red de casa, para abrir la
# nota QR desde el celular. Si el router te da otra IP, cámbiala aquí y en CORS.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.X.X

DJANGO_TIME_ZONE=America/La_Paz


# ----------------------------------------------------------------------------
# 2. BASE DE DATOS LOCAL                                       [usa el código]
# ----------------------------------------------------------------------------
#
#  Hay DOS Postgres posibles en tu PC; elegir cuál con estas variables:
#
#    a) Docker (recomendado) → `docker compose up -d`
#       El compose ya fija sus propios valores (erp/erp en el host "db") y
#       pisa los de aquí. No hace falta tocar nada.
#       Desde fuera del contenedor (pgAdmin, DBeaver): localhost:5440, erp/erp.
#
#    b) PostgreSQL 18 instalado en Windows (servicio postgresql-x64-18)
#       Solo si corres `python manage.py runserver` SIN Docker. Son los de abajo.
#       Ojo: ese servicio escucha en el 5433, no en el 5432.
#
DB_NAME=erp_dev
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=127.0.0.1
DB_PORT=5433


# ----------------------------------------------------------------------------
# 3. BASE DE DATOS DE PRODUCCIÓN — DATABASE_URL                [usa el código]
# ----------------------------------------------------------------------------
#
#  Si DATABASE_URL tiene valor, GANA sobre todo lo de la sección 2.
#  Déjala VACÍA aquí: si la llenas, tu runserver local escribe en la base de
#  producción. La cadena real se guarda abajo, en SUPABASE_DB_URL, y se usa
#  solo cuando quieras, en la misma línea del comando:
#
#    DATABASE_URL="$SUPABASE_DB_URL" python manage.py migrate
#
DATABASE_URL=

# Supabase exige SSL. Solo se pone en False para un Postgres sin SSL.
DB_SSL_REQUIRE=True

# Forzar el modo "pooler en transacción" aunque el puerto no sea 6543.
# Con el Session pooler (5432), que es el que usamos, va en False.
DB_POOLER=False


# ----------------------------------------------------------------------------
# 4. SUPABASE                                                    [solo libreta]
# ----------------------------------------------------------------------------
#
#  Panel: https://supabase.com/dashboard/project/<REF>
#  Región: elegir la MÁS CERCANA a la de Railway (US East), no São Paulo:
#  cada consulta cruza esa distancia, y una vista hace decenas de consultas.
#
#  Plan free: se PAUSA a los 7 días sin actividad (lo evita el workflow de
#  GitHub Actions) y NO tiene respaldos (los hace otro workflow).

# Identificador del proyecto: la parte "abcdefghijkl" de https://abcdefghijkl.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_REGION=

# Contraseña de la base que pide Supabase al crear el proyecto. NO se vuelve a
# mostrar; si se pierde, hay que resetearla (Database → Settings).
SUPABASE_DB_PASSWORD=

# Cadena de conexión → botón "Connect" → pestaña "Session pooler" (puerto 5432).
#   NO usar "Direct connection": es solo IPv6 y Railway no siempre llega.
#   NO usar "Transaction pooler" (6543): rompe sentencias preparadas de Django
#   (lección del proyecto de Si2; settings.py lo tolera, pero no hace falta).
# Formato:
#   postgresql://postgres.<REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Claves de la API (Project Settings → API Keys). Hoy el ERP no las usa: el
# login y la API los hace Django. Se guardan por si más adelante se usa
# Realtime o se sube a Storage directo desde el navegador.
#   publishable/anon: pública, va en el frontend si algún día hace falta.
#   secret/service_role: SALTA TODAS LAS REGLAS. Jamás en el frontend ni en git.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage (fotos de productos), compatible con S3 → Storage → Settings → S3.
# Se llenan cuando lleguemos a las fotos (django-storages).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=productos


# ----------------------------------------------------------------------------
# 5. RAILWAY                                                     [solo libreta]
# ----------------------------------------------------------------------------
#
#  Cuenta: la de Karen (plan Hobby, $5/mes con $5 de uso incluidos, COMPARTIDOS
#  con sus otros proyectos). Hay un límite duro de gasto configurado en
#  Workspace → Usage para no volver a terminar debiendo.
#
#  Las variables de producción NO se copian de aquí a mano una por una:
#  están en docs/DESPLIEGUE.md §2, y se cargan con `railway variables --set`.
RAILWAY_PROJECT_NAME=
RAILWAY_PUBLIC_URL=


# ----------------------------------------------------------------------------
# 6. CORS / CSRF — quién puede llamar a la API desde un navegador [usa el código]
# ----------------------------------------------------------------------------
# 5173 = panel React (Vite) · 5500 = PWA de listas con Live Server.
# Sin el origen exacto aquí, el navegador bloquea la llamada y el error que se
# ve en la consola no siempre dice "CORS".
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173,http://192.168.X.X:5173

# Solo hace falta en producción (con https://). En local queda vacío.
CSRF_TRUSTED_ORIGINS=


# ----------------------------------------------------------------------------
# 7. NOTA DE VENTA PÚBLICA (QR)                                [usa el código]
# ----------------------------------------------------------------------------
# Vacío = el QR usa el host desde el que se emitió la venta.
# En producción: el dominio DEFINITIVO. Un QR impreso apunta ahí para siempre.
NOTA_PUBLICA_BASE_URL=
